<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="QuickAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Style.Triggers>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
    </Style.Triggers>
  </Style>

  <DataTemplate x:Key="QuickTileFace">
    <StackPanel Margin="11,0" HorizontalAlignment="Stretch">
      <TextBlock x:Name="Icon" Text="{Binding Glyph}" FontSize="18" Height="23" VerticalAlignment="Center"
                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
      <TextBlock Text="{Binding Label}" ToolTip="{Binding Label}" Foreground="{DynamicResource Ink}"
                 FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
    </StackPanel>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding Plugin}" Value="{x:Null}"><Setter TargetName="Icon" Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/></DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <DataTemplate x:Key="QuickPluginFace">
    <DockPanel Margin="10,0,4,0">
      <Border Width="26" Height="26" Background="{DynamicResource Hover}" CornerRadius="6" Margin="0,0,9,0">
        <TextBlock Text="{Binding Glyph}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15"
                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
      </Border>
      <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11" Margin="8,0,1,0"
                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                 Text="{Binding (AutomationProperties.ItemStatus), RelativeSource={RelativeSource AncestorType=Button}}"/>
      <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Ink}" FontSize="12" FontWeight="SemiBold"
                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
    </DockPanel>
  </DataTemplate>

  <Style x:Key="LevelPage" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton">
      <Grid Background="Transparent"><Border Height="4" CornerRadius="2" Margin="0,0,-10,0" Background="{TemplateBinding Background}"/></Grid>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="QuickLevel" TargetType="Slider">
    <Setter Property="Height" Value="40"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
      <Grid x:Name="Rail" Background="Transparent">
        <Border Margin="0,1" x:Name="FocusRing" CornerRadius="6" BorderThickness="1" BorderBrush="Transparent"/>
        <Border Background="{DynamicResource Line}" Height="4" CornerRadius="2"/>
        <Track x:Name="PART_Track" Orientation="Horizontal">
          <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource LevelPage}" Background="{DynamicResource Accent}" Command="{x:Static Slider.DecreaseLarge}"/></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb Width="20" Focusable="False" Cursor="Hand">
            <Thumb.Template><ControlTemplate TargetType="Thumb">
              <Grid Background="Transparent">
                <Ellipse Width="18" Height="18" Fill="{DynamicResource TooltipSurface}" Stroke="{DynamicResource Muted}" StrokeThickness="0.8"/>
                <Ellipse x:Name="Dot" Width="10" Height="10" Fill="{DynamicResource Accent}"/>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Dot" Property="Width" Value="12"/><Setter TargetName="Dot" Property="Height" Value="12"/></Trigger>
                <Trigger Property="IsDragging" Value="True"><Setter TargetName="Dot" Property="Width" Value="8"/><Setter TargetName="Dot" Property="Height" Value="8"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate></Thumb.Template>
          </Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource LevelPage}" Background="Transparent" Command="{x:Static Slider.IncreaseLarge}"/></Track.IncreaseRepeatButton>
        </Track>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Rail" Property="Opacity" Value="0.45"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
