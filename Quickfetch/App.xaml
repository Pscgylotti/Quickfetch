<Application x:Class="Quickfetch.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Quickfetch" ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="TooltipSurface" Color="#F5F7FA"/>
    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="{DynamicResource TooltipSurface}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="MaxWidth" Value="580"/><Setter Property="Padding" Value="10,6"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="HorizontalOffset" Value="8"/><Setter Property="VerticalOffset" Value="8"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter>
    </Style>
    <SolidColorBrush x:Key="Surface" Color="#10F8FAFD"/>
    <SolidColorBrush x:Key="Panel" Color="#38FFFFFF"/>
    <SolidColorBrush x:Key="KeyboardSurface" Color="#28F8FAFD"/>
    <SolidColorBrush x:Key="KeySurface" Color="#80FFFFFF"/>
    <SolidColorBrush x:Key="Ink" Color="#18253D"/>
    <SolidColorBrush x:Key="Muted" Color="#6F7B92"/>
    <SolidColorBrush x:Key="Line" Color="#33788399"/>
    <SolidColorBrush x:Key="Accent" Color="#3F6FD8"/>
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Selection" Color="#3D4775DB"/>
    <SolidColorBrush x:Key="Hover" Color="#121E3250"/>
    <SolidColorBrush x:Key="Pressed" Color="#1E1E3250"/>
    <!-- Shared motion: short, decelerating transitions so touch feedback lands on the first frame. -->
    <QuadraticEase x:Key="MotionOut" EasingMode="EaseOut"/>
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ScrollGrip" TargetType="Thumb">
      <!-- Track owns thumb length. A larger MinHeight is clipped by its smaller slot. -->
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
        <Border Background="Transparent"><Border x:Name="Grip" CornerRadius="4" Background="{DynamicResource Muted}" Opacity="0.4" Width="4"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Opacity" Value="0.75"/><Setter TargetName="Grip" Property="Width" Value="6"/></Trigger>
          <Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="Grip" Property="Opacity" Value="1"/><Setter TargetName="Grip" Property="Width" Value="6"/></Trigger>
          <DataTrigger Binding="{Binding Path=(local:TouchScrollBar.Active), RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="True"><Setter TargetName="Grip" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="Grip" Property="Opacity" Value="1"/><Setter TargetName="Grip" Property="Width" Value="8"/></DataTrigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="32"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="local:TouchScrollBar.Enabled" Value="True"/>
      <Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Grid Background="Transparent" Margin="0,4">
          <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
            <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
            <Track.Thumb><Thumb x:Name="GripThumb" Style="{StaticResource ScrollGrip}"/></Track.Thumb>
            <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
          </Track>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.3"/></Trigger>
          <Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter TargetName="GripThumb" Property="MinWidth" Value="32"/><Setter TargetName="GripThumb" Property="MinHeight" Value="0"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Height" Value="12"/><Setter Property="Width" Value="Auto"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Style>
    <!-- Hover and press are overlays animated over the button's own background, so toggled
         backgrounds (mode, keyboard, settings, Enter key) keep their state while giving feedback. -->
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="12,6"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5" Background="Transparent">
          <Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform>
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"/>
          <Border x:Name="HoverLayer" Background="{DynamicResource Hover}" CornerRadius="6" Opacity="0"/>
          <Border x:Name="PressLayer" Background="{DynamicResource Pressed}" CornerRadius="6" Opacity="0"/>
          <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True">
            <!-- Plain-string labels follow the button's Foreground instead of the app-wide Ink TextBlock style. -->
            <ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Style></ContentPresenter.Resources>
          </ContentPresenter>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" EasingFunction="{StaticResource MotionOut}"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
            <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" EasingFunction="{StaticResource MotionOut}"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
          </Trigger>
          <Trigger Property="IsPressed" Value="True">
            <Trigger.EnterActions><BeginStoryboard><Storyboard>
              <DoubleAnimation Storyboard.TargetName="PressLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.06"/>
              <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.96" Duration="0:0:0.08" EasingFunction="{StaticResource MotionOut}"/>
              <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.96" Duration="0:0:0.08" EasingFunction="{StaticResource MotionOut}"/>
            </Storyboard></BeginStoryboard></Trigger.EnterActions>
            <Trigger.ExitActions><BeginStoryboard><Storyboard>
              <DoubleAnimation Storyboard.TargetName="PressLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22" EasingFunction="{StaticResource MotionOut}"/>
              <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2" EasingFunction="{StaticResource MotionOut}"/>
              <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2" EasingFunction="{StaticResource MotionOut}"/>
            </Storyboard></BeginStoryboard></Trigger.ExitActions>
          </Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- Checkboxes render as Fluent toggle switches with a 40-DIP touch row. -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="MinHeight" Value="40"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <EventSetter Event="Checked" Handler="Switch_Toggled"/><EventSetter Event="Unchecked" Handler="Switch_Toggled"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Grid Background="Transparent">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid Width="38" Height="20" VerticalAlignment="Center">
            <Border x:Name="Track" CornerRadius="10" BorderBrush="{DynamicResource Muted}" BorderThickness="1.2" Background="Transparent"/>
            <Border x:Name="TrackOn" CornerRadius="10" Background="{DynamicResource Accent}" Opacity="0"/>
            <Ellipse x:Name="Knob" Width="12" Height="12" Fill="{DynamicResource Muted}" HorizontalAlignment="Left" Margin="4,0,0,0" RenderTransformOrigin="0.5,0.5">
              <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
            </Ellipse>
          </Grid>
          <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
        </Grid>
        <ControlTemplate.Triggers>
          <!-- State comes from setters so a checked switch renders correctly on first paint;
               App.Switch_Toggled glides the knob only on real Checked/Unchecked changes. -->
          <Trigger Property="IsChecked" Value="True">
            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource OnAccent}"/>
            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Knob" Property="Margin" Value="0,0,4,0"/>
            <Setter TargetName="TrackOn" Property="Opacity" Value="1"/><Setter TargetName="Track" Property="BorderBrush" Value="Transparent"/>
          </Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Ink}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Application.Resources>
</Application>
