<Window x:Class="Quickfetch.GestureSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{local:Tr Tadd078e51c47}" Icon="Assets/Quickfetch.ico" Width="720" Height="740" MinWidth="560" MinHeight="440" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#202632" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" xmlns:local="clr-namespace:Quickfetch">
  <Window.Resources>
    <SolidColorBrush x:Key="GestureField" Color="#FFF0F3F8"/>
    <SolidColorBrush x:Key="GesturePopup" Color="#FFF7F9FD"/>
    <SolidColorBrush x:Key="GestureBorder" Color="#FFC0CBDC"/>
    <Style TargetType="TextBox"><Setter Property="MinHeight" Value="42"/><Setter Property="Padding" Value="12,9"/><Setter Property="Background" Value="{DynamicResource GestureField}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="CaretBrush" Value="{DynamicResource Accent}"/><Setter Property="SelectionBrush" Value="{DynamicResource Selection}"/><Setter Property="BorderBrush" Value="{DynamicResource GestureBorder}"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Field" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="MinHeight" Value="42"/><Setter Property="Padding" Value="12,9"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="3,1"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" TextElement.Foreground="{TemplateBinding Foreground}"/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource Selection}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource Selection}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="MinHeight" Value="42"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource GestureField}"/><Setter Property="BorderBrush" Value="{DynamicResource GestureBorder}"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press" Background="{TemplateBinding Background}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Field" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource GestureBorder}" BorderThickness="1"><TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter IsHitTestVisible="False" Margin="12,8,36,8" VerticalAlignment="Center" HorizontalAlignment="Left" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" TextElement.Foreground="{TemplateBinding Foreground}"/>
          <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
            <Border Background="{DynamicResource GesturePopup}" BorderBrush="{DynamicResource GestureBorder}" BorderThickness="1" CornerRadius="9" Padding="3" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="300">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True" PanningMode="VerticalOnly"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
            </Border>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Border Background="{DynamicResource Surface}" Padding="20,18,20,16">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
        <TextBlock Text="{local:Tr Tf22e864a1c15}" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Text="{local:Tr T1a5df0737aca}" Foreground="{DynamicResource Muted}" FontSize="12.5" Margin="0,4,0,8"/>
        <CheckBox x:Name="EnabledCheck" Content="{local:Tr T497d8c18f7e0}"/>
        <CheckBox x:Name="RightClickCheck" Content="{local:Tr T214592105d0d}"/>
      </StackPanel>
      <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
        <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#FFF6A7A7" Margin="0,0,0,8"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="{local:Tr T2cd0f3be8738}" IsCancel="True" MinWidth="96" Height="44" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Line}" BorderThickness="1"/><Button x:Name="SaveButton" Content="{local:Tr Ta3030bf8f16d}" Click="Save_Click" Background="{DynamicResource Accent}" Foreground="{DynamicResource OnAccent}" FontWeight="SemiBold" MinWidth="112" Height="44" Margin="8,0,0,0"/></StackPanel>
      </StackPanel>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
        <StackPanel>
          <TextBlock Text="{local:Tr Td85ce9154092}" FontWeight="SemiBold" Margin="0,4,0,6"/>
          <ComboBox x:Name="DisplayPicker" DisplayMemberPath="Label"/>
          <TextBlock Text="{local:Tr T15a160965a91}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,7,0,14"/>
          <StackPanel x:Name="Editors"/>
          <TextBlock Text="{local:Tr T06541ef20643}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,10,0,10"/>
          <TextBlock Text="{local:Tr Tc2ac82d76350}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="11"/>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</Window>
