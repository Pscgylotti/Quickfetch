<Window x:Class="Quickfetch.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Quickfetch"
        Title="Quickfetch" Icon="Assets/Quickfetch.ico" Width="660" Height="470" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="False" Background="Transparent" ShowInTaskbar="False" Topmost="True" FontFamily="Segoe UI" UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown" Deactivated="Window_Deactivated">
  <Window.Resources>
    <DataTemplate x:Key="FileItemTemplate">
      <Grid Width="{Binding FileRowsWidth, RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Left">
        <Grid.ToolTip><ToolTip><TextBlock Text="{Binding Path}" TextWrapping="Wrap" MaxWidth="554"/></ToolTip></Grid.ToolTip>
        <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding FileNameWidth, RelativeSource={RelativeSource AncestorType=Window}}"/><ColumnDefinition Width="{Binding FilePathWidth, RelativeSource={RelativeSource AncestorType=Window}}"/><ColumnDefinition Width="{Binding FileSizeWidth, RelativeSource={RelativeSource AncestorType=Window}}"/><ColumnDefinition Width="{Binding FileDateWidth, RelativeSource={RelativeSource AncestorType=Window}}"/></Grid.ColumnDefinitions>
        <Grid Margin="0,0,12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Image Source="{Binding Icon}" Width="24" Height="24" VerticalAlignment="Center" HorizontalAlignment="Left"/>
          <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13.5" FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        </Grid>
        <TextBlock Grid.Column="1" Text="{Binding Location}" FontSize="12" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="3" Text="{Binding DateText}" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
      </Grid>
    </DataTemplate>
    <Style x:Key="FileColumnGrip" TargetType="Thumb">
      <Setter Property="Width" Value="28"/><Setter Property="MinHeight" Value="44"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Cursor" Value="SizeWE"/>
      <Setter Property="ToolTip" Value="左右拖动调整列宽"/><Setter Property="AutomationProperties.Name" Value="调整相邻两列宽度"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="Transparent"><Border x:Name="Grip" Width="1.5" Height="16" CornerRadius="1" Background="{DynamicResource Muted}" Opacity="0.35"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Opacity" Value="0.9"/><Setter TargetName="Grip" Property="Height" Value="22"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="Grip" Property="Opacity" Value="1"/><Setter TargetName="Grip" Property="Width" Value="2.5"/><Setter TargetName="Grip" Property="Height" Value="26"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="HeaderAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="48"/><Setter Property="Height" Value="48"/>
      <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="2,0,0,0"/><Setter Property="Focusable" Value="False"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="HeaderGlyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/><Setter Property="FontSize" Value="17"/>
      <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
      <Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="SecondaryAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="MinHeight" Value="40"/><Setter Property="Padding" Value="14,0"/><Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="ColumnAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Focusable" Value="False"/><Setter Property="Height" Value="40"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="8,0"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>
  </Window.Resources>
  <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="8" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
  <Border x:Name="LauncherSurface" RenderTransformOrigin="0.5,0.4" Focusable="True" KeyboardNavigation.IsTabStop="False" CornerRadius="8" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid Margin="16,8,16,10">
      <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="26"/></Grid.RowDefinitions>
      <DockPanel Grid.Row="0" MouseLeftButtonDown="Header_Drag">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="20" Height="20" CornerRadius="5" Background="{DynamicResource Accent}" Margin="2,0,10,0" IsHitTestVisible="False">
            <Viewbox Width="16" Height="16"><Canvas Width="32" Height="32">
              <Path Data="M20.63,19.14 A8,8 0 1 1 21.75,10.62 M21,21 L26,26" Stroke="{DynamicResource OnAccent}" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              <Path Data="M16,6.5 L10,15 H14.5 L12.5,22 L21,11.5 H16.5 Z" Fill="{DynamicResource OnAccent}"/>
            </Canvas></Viewbox>
          </Border>
          <TextBlock x:Name="ModeLabel" Text="QUICKFETCH" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
          <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="4" Padding="6,1,6,2" Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="Win + S" FontSize="10.5" Foreground="{DynamicResource Muted}"/></Border>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="DownloadsButton" Style="{StaticResource HeaderAction}" Click="Downloads_Click" ToolTip="下载队列与历史" AutomationProperties.Name="下载队列与历史"><TextBlock Text="&#xE896;" Style="{StaticResource HeaderGlyph}"/></Button>
          <Button x:Name="ModeButton" Style="{StaticResource HeaderAction}" Click="Mode_Click" ToolTip="搜索文件 · Tab" AutomationProperties.Name="切换应用与文件搜索"><TextBlock Text="&#xE8AB;" Style="{StaticResource HeaderGlyph}"/></Button>
          <Button x:Name="KeyboardToggle" Style="{StaticResource HeaderAction}" Click="Keyboard_Click" ToolTip="展开或收起触屏键盘" AutomationProperties.Name="切换触屏键盘"><TextBlock Text="&#xE765;" Style="{StaticResource HeaderGlyph}" FontSize="19"/></Button>
          <Button x:Name="SettingsButton" Style="{StaticResource HeaderAction}" Click="Settings_Click" ToolTip="设置" AutomationProperties.Name="设置"><TextBlock Text="&#xE713;" Style="{StaticResource HeaderGlyph}"/></Button>
          <Button x:Name="HideButton" Style="{StaticResource HeaderAction}" Click="Hide_Click" ToolTip="隐藏窗口 · Esc" AutomationProperties.Name="隐藏窗口"><TextBlock Text="&#xE921;" Style="{StaticResource HeaderGlyph}" FontSize="13"/></Button>
        </StackPanel>
      </DockPanel>
      <Border Grid.Row="1" Height="52" Margin="0,4,0,10" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="14,0">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
          <TextBox x:Name="Query" Grid.Column="1" AutomationProperties.Name="搜索快捷方式" FontSize="21" FontWeight="Medium" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Ink}" CaretBrush="{DynamicResource Accent}" SelectionBrush="{DynamicResource Accent}" VerticalContentAlignment="Center" TextChanged="Query_TextChanged" InputMethod.IsInputMethodEnabled="False" IsReadOnlyCaretVisible="True" PreviewTouchDown="Query_TouchDown" PreviewStylusDown="Query_StylusDown" PreviewMouseDown="Query_MouseDown">
            <TextBox.Template><ControlTemplate TargetType="TextBox"><Border Background="Transparent"><ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></Border></ControlTemplate></TextBox.Template>
          </TextBox>
          <TextBlock x:Name="Placeholder" Grid.Column="1" Text="输入英文、数字或拼音，快速启动" FontSize="18" Margin="2,0,0,0" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" IsHitTestVisible="False"/>
          <Canvas x:Name="TouchCaret" Grid.Column="1" Visibility="Collapsed" IsHitTestVisible="False" ClipToBounds="True"><Line x:Name="TouchCaretLine" X1="0" X2="0" Y1="0" Y2="26" Stroke="{DynamicResource Accent}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas>
        </Grid>
      </Border>
      <Border x:Name="SettingsPanel" Grid.Row="2" Visibility="Collapsed" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="14,8,10,10" Margin="0,0,0,10">
        <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
        <StackPanel>
          <DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource SecondaryAction}" Content="选择文件夹" Click="ChooseFolder_Click"/><Button x:Name="FolderButton" DockPanel.Dock="Right" Style="{StaticResource SecondaryAction}" Content="打开当前文件夹" Click="OpenFolder_Click" Margin="0,0,6,0" ToolTip="打开 .lnk 快捷方式文件夹" AutomationProperties.Name="打开快捷方式文件夹"/>
            <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock x:Name="FolderLabel" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0"/></DockPanel>
          <WrapPanel Margin="0,4,0,0"><CheckBox x:Name="RecursiveCheck" Content="包含子文件夹" Click="Recursive_Click" Margin="0,0,24,0"/><CheckBox x:Name="RegisteredAppsCheck" Content="包含 Windows 注册应用" Click="RegisteredApps_Click" ToolTip="包括 ChatGPT 等没有 .lnk 的应用；按 F5 刷新" Margin="0,0,24,0"/><CheckBox x:Name="AutostartCheck" Content="开机启动" Click="Autostart_Click" Margin="0,0,24,0"/><CheckBox x:Name="FilePreviewCheck" Content="启用文件预览" Click="FilePreview_Click" Margin="0,0,24,0"/><CheckBox x:Name="BuiltInKeyboardCheck" Content="使用 Quickfetch 内置键盘" Click="BuiltInKeyboard_Click" ToolTip="取消勾选后使用 Windows 系统触摸键盘"/></WrapPanel>
          <Border Height="1" Background="{DynamicResource Line}" Margin="0,6,4,6"/>
          <DockPanel><Button Content="触屏手势…" Style="{StaticResource SecondaryAction}" Click="Gestures_Click" DockPanel.Dock="Right"/>
            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0"><TextBlock x:Name="GestureStatus" Text="全局触屏手势" FontSize="12" TextWrapping="Wrap"/><TextBlock Text="仅启动此文件夹中的 .lnk；右键托盘图标可退出程序。" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel></DockPanel>
        </StackPanel>
      </Border>
      <Grid x:Name="ResultsSurface" Grid.Row="3">
        <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid x:Name="FileSortHeader" Visibility="Collapsed" Margin="10,0,42,2" SizeChanged="FileHeader_SizeChanged">
          <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding FileNameWidth, RelativeSource={RelativeSource AncestorType=Window}}"/><ColumnDefinition Width="{Binding FilePathWidth, RelativeSource={RelativeSource AncestorType=Window}}"/><ColumnDefinition Width="{Binding FileSizeWidth, RelativeSource={RelativeSource AncestorType=Window}}"/><ColumnDefinition Width="{Binding FileDateWidth, RelativeSource={RelativeSource AncestorType=Window}}"/></Grid.ColumnDefinitions>
          <Button x:Name="NameSort" Margin="-8,0,28,0" Style="{StaticResource ColumnAction}" Content="名称 ↑" Tag="0" Click="Sort_Click"/>
          <Button x:Name="PathSort" Margin="-8,0,28,0" Style="{StaticResource ColumnAction}" Grid.Column="1" Content="路径" Tag="1" Click="Sort_Click"/>
          <Button x:Name="SizeSort" Margin="-8,0,28,0" Style="{StaticResource ColumnAction}" Grid.Column="2" Content="大小" Tag="2" Click="Sort_Click"/>
          <Thumb Grid.Column="0" Tag="0" Style="{StaticResource FileColumnGrip}" DragDelta="FileColumn_DragDelta" DragCompleted="FileColumn_DragCompleted" PreviewTouchDown="FileColumn_TouchDown" PreviewTouchMove="FileColumn_TouchMove" PreviewTouchUp="FileColumn_TouchUp" LostTouchCapture="FileColumn_LostTouchCapture"/>
          <Thumb Grid.Column="1" Tag="1" Style="{StaticResource FileColumnGrip}" DragDelta="FileColumn_DragDelta" DragCompleted="FileColumn_DragCompleted" PreviewTouchDown="FileColumn_TouchDown" PreviewTouchMove="FileColumn_TouchMove" PreviewTouchUp="FileColumn_TouchUp" LostTouchCapture="FileColumn_LostTouchCapture"/>
          <Thumb Grid.Column="2" Tag="2" Style="{StaticResource FileColumnGrip}" DragDelta="FileColumn_DragDelta" DragCompleted="FileColumn_DragCompleted" PreviewTouchDown="FileColumn_TouchDown" PreviewTouchMove="FileColumn_TouchMove" PreviewTouchUp="FileColumn_TouchUp" LostTouchCapture="FileColumn_LostTouchCapture"/>
          <Button x:Name="DateSort" Margin="-8,0,0,0" Style="{StaticResource ColumnAction}" Grid.Column="3" Content="修改日期" Tag="6" Click="Sort_Click"/>
        </Grid>
        <ListBox x:Name="Results" Grid.Row="1" VirtualizingPanel.ScrollUnit="Pixel" AutomationProperties.Name="搜索结果" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.PanningMode="VerticalOnly" ScrollViewer.IsDeferredScrollingEnabled="False" HorizontalContentAlignment="Stretch" PreviewMouseLeftButtonDown="Results_FileMouseDown" PreviewMouseLeftButtonUp="Results_FileMouseUp" PreviewMouseMove="Results_FileMouseMove" MouseDoubleClick="Results_DoubleClick" PreviewMouseRightButtonUp="Results_RightClick" PreviewTouchDown="Results_TouchDown" PreviewTouchMove="Results_TouchMove" PreviewTouchUp="Results_TouchUp">
          <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="MinHeight" Value="48"/><Setter Property="Margin" Value="0,1"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><EventSetter Event="Selected" Handler="ResultRow_Selected"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
            <!-- Hover, selection and the accent pill fade/grow independently, so arrow-key moves glide. -->
            <Grid Background="Transparent">
              <Border x:Name="HoverLayer" CornerRadius="8" Background="{DynamicResource Hover}" Opacity="0"/>
              <Border x:Name="SelectedLayer" CornerRadius="8" Background="{DynamicResource Selection}" Opacity="0"/>
              <Border x:Name="Indicator" Width="3" Height="18" CornerRadius="1.5" Background="{DynamicResource Accent}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" Opacity="0" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform ScaleY="1"/></Border.RenderTransform></Border>
              <ContentPresenter Margin="10,6"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <!-- Setters render a pre-selected row immediately; ResultRow_Selected animates real moves. -->
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="SelectedLayer" Property="Opacity" Value="1"/><Setter TargetName="Indicator" Property="Opacity" Value="1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid Width="32" Height="32" HorizontalAlignment="Left">
              <Image Source="{Binding Icon}" Width="32" Height="32" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
              <Border CornerRadius="8" Background="{DynamicResource Selection}">
                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                <TextBlock Text="{Binding Initial}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="Medium" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Location}" FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,1,8,0"/></StackPanel>
            <TextBlock Grid.Column="2" Text="{Binding MatchLabel}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Muted}" Margin="8,0,4,0"/>
          </Grid></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="26" Foreground="{DynamicResource Muted}" Opacity="0.45" HorizontalAlignment="Center" Margin="0,0,0,10" Visibility="{Binding Visibility, ElementName=EmptyMessage}"/>
          <TextBlock x:Name="EmptyMessage" Text="正在读取快捷方式…" FontSize="12.5" LineHeight="20" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" MaxWidth="460" TextAlignment="Center" Visibility="Collapsed"/>
          <Button x:Name="InstallEverythingButton" Content="下载 / 安装 Everything" Click="InstallEverything_Click" Visibility="Collapsed" Focusable="False" Margin="0,14,0,0" Height="44" Padding="20,0" HorizontalAlignment="Center" Background="{DynamicResource Accent}" Foreground="{DynamicResource OnAccent}" FontWeight="SemiBold"/>
        </StackPanel>
      </Grid>
      <local:TouchKeyboard x:Name="QuickKeyboard" Grid.Row="4" Visibility="Collapsed" Margin="0,8,0,0"/>
      <DockPanel Grid.Row="5" Margin="4,4,4,0"><TextBlock x:Name="Status" DockPanel.Dock="Left" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/><Button x:Name="MoreResults" DockPanel.Dock="Left" Visibility="Collapsed" Content="加载更多" Click="More_Click" Focusable="False" FontSize="11" Foreground="{DynamicResource Accent}" Padding="8,0" Height="24" Margin="6,0,0,0"/><TextBlock x:Name="ResultHint" Text="↑ ↓ 选择    Enter 启动    Tab 文件" FontSize="11" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
    </Grid>
    <Border x:Name="FilePreviewPanel" Grid.Column="1" Width="300" Margin="0,12,16,12" Padding="16" CornerRadius="10" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Visibility="Collapsed">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" IsDeferredScrollingEnabled="False">
        <StackPanel>
          <TextBlock Text="预览" Foreground="{DynamicResource Accent}" FontSize="11" Margin="0,0,0,8"/>
          <TextBlock x:Name="PreviewTitle" Text="文件预览" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,14"/>
          <Image x:Name="PreviewImage" MaxWidth="252" MaxHeight="220" Stretch="Uniform" Visibility="Collapsed" Margin="0,0,0,14"/>
          <TextBlock x:Name="PreviewDetails" Text="选择文件以预览" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" LineHeight="21"/>
          <TextBlock x:Name="PreviewText" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap" Margin="0,16,0,0"/>
        </StackPanel>
      </ScrollViewer>
    </Border>
    </Grid>
  </Border>
</Window>
