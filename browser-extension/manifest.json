{
  "version": "0.0.5",
  "name": "Quickfetch Downloads",
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "description": "将浏览器文件下载加入 Quickfetch 后台下载队列",
  "action": {
    "default_title": "Quickfetch 下载",
    "default_popup": "popup.html"
  },
  "manifest_version": 3,
  "permissions": [
    "downloads",
    "nativeMessaging",
    "contextMenus",
    "storage"
  ]
}
